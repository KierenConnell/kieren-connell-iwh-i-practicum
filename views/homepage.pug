doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title= title
    link(rel='stylesheet', href='/css/style.css')
  body
    main
      p.eyebrow Integrating With HubSpot I · Practicum 2026
      h1 Workshop Jobs
      p Keep track of small automation, integration and internal tool jobs.
      a.button(href='/update-cobj') Add to this table
      if records.length
        .table-wrap
          table
            caption= `${records.length} workshop job${records.length === 1 ? '' : 's'}`
            thead
              tr
                th(scope='col') Name
                th(scope='col') Job type
                th(scope='col') Estimated hours
            tbody
              each record in records
                tr
                  td= record.properties.name
                  td= record.properties.job_type
                  td= record.properties.estimated_hours
      else
        p.empty No jobs yet. Add your first job using the button above.
